# team_schedule 환경변수 예시. 실제 값으로 채운 뒤 셸에 export 하세요.

# 공유 캘린더 ID (예: team@group.calendar.google.com)
GOOGLE_CALENDAR_ID=your-team@group.calendar.google.com

# 서비스 계정 키(JSON) 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 처리한 일정 상태를 저장할 파일 (선택, 기본값 .team_schedule_state.json)
TEAM_SCHEDULE_STATE_FILE=.team_schedule_state.json

# 표시/계산 기준 시간대 (선택, 기본값 Asia/Seoul)
TEAM_SCHEDULE_TZ=Asia/Seoul
